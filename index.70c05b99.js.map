"use strict";
// write code here
function parseSalary(value) {
    return Number(value.replace(/[^0-9.-]+/g, ""));
}
function sortList(list) {
    var items = Array.from(list.querySelectorAll("li"));
    items.sort(function(a, b) {
        return parseSalary(b.dataset.salary) - parseSalary(a.dataset.salary);
    });
    items.forEach(function(item) {
        return list.appendChild(item);
    });
}
function getEmployees(list) {
    return Array.from(list.querySelectorAll("li")).map(function(item) {
        return {
            name: item.innerText,
            age: item.dataset.age,
            position: item.dataset.position,
            salary: item.dataset.salary
        };
    });
}
var employeeList = document.querySelector("ul");
sortList(employeeList);
var employees = getEmployees(employeeList);
console.log(employees);

